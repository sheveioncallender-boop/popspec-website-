<odoo>
<template id="popspec_footer" name="Pop Spec footer"><div class="popspec-content ps-footer"><div class="wrap footer-main"><div class="footer-brand"><a href="/" class="ps-logo-crop" aria-label="Pop Spec home"><img src="/popspec_website/static/src/img/popspec-logo.jpeg" alt="Pop Spec Ltd" width="1600" height="850"/></a><p>Precision optical products + spectacles.<br/>A fresh perspective, every day.</p></div><div><h2>Explore</h2><a href="/shop">Shop eyewear</a><a href="/optical-services">Our services</a><a href="/lens-guide">Lens guide</a><a href="/about-us">About Pop Spec</a></div><div><h2>Here to help</h2><a href="/visit-us">Visit &amp; contact</a><a href="/contactus">Send an enquiry</a><a href="/my/orders">My orders</a><a href="/my">My account</a></div><div><h2>Let’s talk</h2><a t-if="website.popspec_phone" t-att-href="'tel:' + website.popspec_phone" t-field="website.popspec_phone"/><a t-if="website.popspec_phone_alt" t-att-href="'tel:' + website.popspec_phone_alt" t-field="website.popspec_phone_alt"/><a t-if="website.popspec_email" t-att-href="'mailto:' + website.popspec_email" t-field="website.popspec_email"/><a t-if="website._popspec_whatsapp_url()" t-att-href="website._popspec_whatsapp_url()" target="_blank" rel="noopener">WhatsApp ↗</a><p t-if="website.popspec_address" t-field="website.popspec_address"/></div></div><div class="wrap footer-bottom"><span>© Pop Spec Ltd. All rights reserved.</span><span>Developed by <a href="https://spxcorp.net" target="_blank" rel="noopener">Spxcorp Limited</a></span></div></div></template>
<template id="layout_brand" inherit_id="website.layout" priority="99" name="Pop Spec native Odoo layout branding"><xpath expr="//div[@id='wrapwrap']" position="attributes"><attribute name="t-attf-class" add="#{'popspec-site' if website.popspec_brand_enabled else ''}" separator=" "/></xpath><xpath expr="//footer[@id='bottom']" position="inside"><t t-if="website.popspec_brand_enabled and not no_footer" t-call="popspec_website.popspec_footer"/></xpath><xpath expr="//header/*[1]" position="before"><div t-if="website.popspec_brand_enabled" class="ps-topbar"><span>PRECISION OPTICAL PRODUCTS + SPECTACLES</span><a t-if="website.popspec_phone" t-att-href="'tel:' + website.popspec_phone">Let’s talk <span t-field="website.popspec_phone"/></a></div></xpath></template>
<template id="popspec_header" inherit_id="website_sale.template_header_default" priority="60" name="Pop Spec native header"><xpath expr="//t[@t-call='website.placeholder_header_text_element']" position="attributes"><attribute name="t-if">not website.popspec_brand_enabled</attribute></xpath><xpath expr="//t[@t-call='website.placeholder_header_call_to_action']" position="attributes"><attribute name="t-if">not website.popspec_brand_enabled</attribute></xpath></template>
</odoo>